SUMMARY="A from-scratch BASIC-to-C++ transpiler with a package manager"
DESCRIPTION="eBasic compiles a modern, statically-typed BASIC dialect (with \
TYPE-based OOP, C/C++ interop, and a Cargo-style package manager, ebpm) down \
to C++ source, then invokes the system C++ compiler to produce a native \
executable. Ships three tools: ebc (the compiler driver), ebpm (the package \
manager), and docgen (doc-comment -> Markdown generator)."
HOMEPAGE="https://github.com/yann64/ebasic"
COPYRIGHT="2026 yann64"
LICENSE="MIT"
REVISION="1"

# v1.8.0 (calling through a PROPERTY of function-pointer type) -
# SOURCE_URI/CHECKSUM_SHA256 below point at the real, published tag,
# verified by actually downloading it
# (https://github.com/yann64/ebasic/archive/refs/tags/v1.8.0.tar.gz) and
# computing its real sha256, same as the v1.7.0/v1.6.0/v1.5.0/v1.4.0/
# v1.3.0/v1.2.0/v1.1.0/v1.0.0 recipes before it. Still not yet submitted
# upstream to haikuports - haikuporter's own recipe-format conventions
# were dry-run-verified against real Haiku hardware (M8e), cross-checked
# against app-arch/brotli's real recipe.
SOURCE_URI="https://github.com/yann64/ebasic/archive/refs/tags/v$portVersion.tar.gz"
CHECKSUM_SHA256="2e840a2a8c3623dfd405eb274520d8237b3d4cacd9e1456967e1f65a855e721c"
SOURCE_FILENAME="ebasic-$portVersion.tar.gz"

ARCHITECTURES="all !x86_gcc2"

PROVIDES="
	ebasic = $portVersion
	cmd:ebc = $portVersion
	cmd:ebpm = $portVersion
	cmd:docgen = $portVersion
	cmd:ebasic_lsp = $portVersion
	"
REQUIRES="
	haiku
	"

BUILD_REQUIRES="
	haiku_devel
	"
BUILD_PREREQUIRES="
	cmd:cmake
	cmd:g++
	cmd:gcc
	cmd:make
	"

BUILD()
{
	cmake \
		-B build -S . \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=$prefix \
		-DCMAKE_INSTALL_BINDIR=$binDir \
		-DCMAKE_INSTALL_DATADIR=data

	make -C build $jobArgs
}

INSTALL()
{
	make -C build install
}

TEST()
{
	ctest --test-dir build --output-on-failure
}
