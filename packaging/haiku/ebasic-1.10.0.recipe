SUMMARY="A from-scratch BASIC-to-C++ transpiler with a package manager"
DESCRIPTION="eBasic compiles a modern, statically-typed BASIC dialect (with \
TYPE-based OOP, C/C++ interop, and a Cargo-style package manager, ebpm) down \
to C++ source, then invokes the system C++ compiler to produce a native \
executable. Ships three tools: ebc (the compiler driver), ebpm (the package \
manager), and docgen (doc-comment -> Markdown generator)."
HOMEPAGE="https://github.com/yann64/ebasic"
COPYRIGHT="2026 yann64"
LICENSE="MIT"
REVISION="1"

# v1.10.0 (three portable compiler milestones - generics, multiple-
# interface implementation, coroutines - targeting C++20) -
# SOURCE_URI/CHECKSUM_SHA256 below point at the real, published tag,
# verified by actually downloading it
# (https://github.com/yann64/ebasic/archive/refs/tags/v1.10.0.tar.gz) and
# computing its real sha256, same as every prior recipe. Unlike those
# prior versions, this one has NOT yet been re-verified live on real
# Haiku hardware specifically for the new C++20 requirement (M12's own
# coroutine support needs <coroutine>, real support confirmed only on
# this project's own Linux/macOS/Windows CI matrix and this development
# machine's g++/cl.exe so far) - flagged here rather than silently
# assumed, unlike the four-platform Haiku verification every earlier
# tagged release actually had. Still not yet submitted upstream to
# haikuports - haikuporter's own recipe-format conventions were
# dry-run-verified against real Haiku hardware (M8e) on an earlier
# version, cross-checked against app-arch/brotli's real recipe.
SOURCE_URI="https://github.com/yann64/ebasic/archive/refs/tags/v$portVersion.tar.gz"
CHECKSUM_SHA256="b02aba04fd3a0a9d745ca0f512d3a4207c79e806e2a8fe94f6c7b2ad22c60d0b"
SOURCE_FILENAME="ebasic-$portVersion.tar.gz"

ARCHITECTURES="all !x86_gcc2"

PROVIDES="
	ebasic = $portVersion
	cmd:ebc = $portVersion
	cmd:ebpm = $portVersion
	cmd:docgen = $portVersion
	cmd:ebasic_lsp = $portVersion
	"
REQUIRES="
	haiku
	"

BUILD_REQUIRES="
	haiku_devel
	"
BUILD_PREREQUIRES="
	cmd:cmake
	cmd:g++
	cmd:gcc
	cmd:make
	"

BUILD()
{
	cmake \
		-B build -S . \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=$prefix \
		-DCMAKE_INSTALL_BINDIR=$binDir \
		-DCMAKE_INSTALL_DATADIR=data

	make -C build $jobArgs
}

INSTALL()
{
	make -C build install
}

TEST()
{
	ctest --test-dir build --output-on-failure
}
