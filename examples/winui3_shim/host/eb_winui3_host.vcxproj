<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="obj\eb_winui3_host.vcxproj.nuget.g.props" Condition="Exists('obj\eb_winui3_host.vcxproj.nuget.g.props')" />
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{4D3B1E10-0000-4000-8000-000000000001}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>smoke</RootNamespace>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.17763.0</WindowsTargetPlatformMinVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <CppWinRTOptimized>true</CppWinRTOptimized>
    <UseWinUI>true</UseWinUI>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <CppWinRTAddXamlMetaDataProviderIdl>true</CppWinRTAddXamlMetaDataProviderIdl>
    <GenerateManifest>false</GenerateManifest>
    <AppContainerApplication>false</AppContainerApplication>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="Shared" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>_DEBUG;WINRT_LEAN_AND_MEAN;DISABLE_XAML_GENERATED_MAIN;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <AdditionalIncludeDirectories>%(AdditionalIncludeDirectories);$(ProjectDir);$(IntDir);$(IntDir)Generated Files\</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="App.xaml.cpp">
      <DependentUpon>App.xaml</DependentUpon>
    </ClCompile>
    <ClCompile Include="MainWindow.xaml.cpp">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </ClCompile>
    <ClCompile Include="main.cpp" />
    <ClCompile Include="$(GeneratedFilesDir)module.g.cpp" />
  </ItemGroup>
  <ItemGroup>
    <Midl Include="Project.idl">
      <SubType>Code</SubType>
    </Midl>
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml">
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <Page Include="MainWindow.xaml">
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="pch.h" />
    <ClInclude Include="App.xaml.h">
      <DependentUpon>App.xaml</DependentUpon>
    </ClInclude>
    <ClInclude Include="MainWindow.xaml.h">
      <DependentUpon>MainWindow.xaml</DependentUpon>
    </ClInclude>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CppWinRT">
      <Version>3.0.260818.1</Version>
    </PackageReference>
    <PackageReference Include="Microsoft.WindowsAppSDK">
      <Version>2.4.0</Version>
    </PackageReference>
  </ItemGroup>
  <!-- The C++/WinRT Visual Studio extension (not installed here) normally
       wires MarkupCompilePass1/Pass2 into a native vcxproj's build graph;
       without it, ClCompile never runs them at all (they're only ever
       added to the C#-world CoreCompileDependsOn, gated behind
       BuildingInsideVisualStudio=='true' - CoreCompile doesn't even exist
       for a native vcxproj, and native ClCompile (Microsoft.CppCommon.
       targets) hardcodes DependsOnTargets="SelectClCompile", not a
       $(ClCompileDependsOn) property, so that convention has no effect
       here either). Wired by hand instead, via BeforeTargets. -->
  <Target Name="EBasicRunXamlMarkupCompile" BeforeTargets="ClCompile" DependsOnTargets="MarkupCompilePass1;MarkupCompilePass2">
    <ItemGroup>
      <ClCompile Include="XamlMetaDataProvider.cpp" />
      <ClCompile Include="$(IntDir)XamlTypeInfo.Impl.g.cpp" />
      <ClCompile Include="$(IntDir)XamlTypeInfo.g.cpp" />
    </ItemGroup>
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>
